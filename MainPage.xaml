<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SpreadsheetApp.ViewModels"
             x:Class="SpreadsheetApp.MainPage"
             Title="Електронна таблиця (Вар. 81)">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Spacing="10" Padding="10" BackgroundColor="#f0f0f0">
            <Label Text="Лабораторна робота 1 - Аналіз логічних виразів" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding ModeText}" FontSize="16" TextColor="DarkBlue" HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Обчислити" Command="{Binding EvaluateCommand}" BackgroundColor="Green" TextColor="White" />
                <Button Text="Змінити режим" Command="{Binding ToggleModeCommand}" BackgroundColor="Blue" TextColor="White" />
                <Button Text="Довідка" Clicked="OnHelpClicked" BackgroundColor="Gray" TextColor="White" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="+ Рядок" Command="{Binding AddRowCommand}" />
                <Button Text="- Рядок" Command="{Binding RemoveRowCommand}" />
                <Button Text="+ Стовпець" Command="{Binding AddColumnCommand}" />
                <Button Text="- Стовпець" Command="{Binding RemoveColumnCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Both" Padding="10">
            <Grid x:Name="SpreadsheetGrid" ColumnSpacing="2" RowSpacing="2" />
        </ScrollView>
    </Grid>
</ContentPage>